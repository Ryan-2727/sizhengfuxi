# Browser build variables. These are safe to expose in Cloudflare Pages.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Local administrator/import scripts and Cloudflare Pages Functions only. Never prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudflare Pages Functions only. Keep this server-side; never prefix it with VITE_.
ADMIN_EMAILS=your-email@example.com
