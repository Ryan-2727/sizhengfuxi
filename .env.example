# Browser build variables. These are safe to expose in Cloudflare Pages.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Local administrator/import scripts and Cloudflare Pages Functions only. Never prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudflare Pages Functions only. Keep this server-side; never prefix it with VITE_.
ADMIN_EMAILS=your-email@example.com

# Cloudflare Turnstile. Site key is browser-safe; secret key is Pages Functions only.
TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# Optional Cloudflare Pages Functions email notification. Keep all three server-side.
RESEND_API_KEY=re_your_api_key
FEEDBACK_NOTIFY_EMAIL=your-email@example.com
FEEDBACK_FROM_EMAIL=feedback@your-domain.example
